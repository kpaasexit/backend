pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins
  nodeSelector:
    worker: "true"
  hostNetwork: true
  dnsPolicy: ClusterFirstWithHostNet
  containers:
  - name: kubectl
    image: alpine:latest
    command:
    - sleep
    args:
    - infinity
    resources:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi
  - name: docker
    image: docker:24-dind
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 300m
        memory: 1Gi
    securityContext:
      privileged: true
"""
        }
    }

    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials')
        DOCKER_HUB_REPO = 'leesy010504/exit-question-service'
        IMAGE_TAG = "1.1.${BUILD_NUMBER}"
        DOCKER_HOST = "tcp://localhost:2375"
        GIT_DIFF = ''
    }

    stages {
        stage('Install kubectl') {
            steps {
                container('kubectl') {
                    sh '''
                        apk add --no-cache curl
                        curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl /usr/local/bin/
                        kubectl version --client
                    '''
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (env.GIT_PREVIOUS_SUCCESSFUL_COMMIT) {
                        echo "Comparing with previous: ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT}"
                        GIT_DIFF = sh(
                            script: "git diff --name-only ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT} ${env.GIT_COMMIT}",
                            returnStdout: true
                        ).trim()
                    } else {
                        echo "First build - building all"
                        GIT_DIFF = "ALL"
                    }
                    echo "Changed files:\n${GIT_DIFF}"
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = GIT_DIFF.split('\n')
                    env.BUILD_QUESTION_SERVICE = 'false'

                    if (GIT_DIFF == 'ALL') {
                        env.BUILD_QUESTION_SERVICE = 'true'
                        echo "First build - will build question-service"
                    } else {
                        for (String file : changedFiles) {
                            if (file.startsWith('question-service/') ||
                                file.startsWith('common/') ||
                                file == 'build.gradle' ||
                                file == 'settings.gradle' ||
                                file.startsWith('gradle/') ||
                                file == 'Jenkinsfile' ||
                                file == 'question-service/Jenkinsfile') {
                                env.BUILD_QUESTION_SERVICE = 'true'
                                echo "Changes detected: ${file}"
                                break
                            }
                        }
                    }

                    echo env.BUILD_QUESTION_SERVICE == 'true' ?
                        "Will build question-service" :
                        "Skipping question-service"
                }
            }
        }

        stage('Build Question Service') {
            when {
                expression { env.BUILD_QUESTION_SERVICE == 'true' }
            }
            steps {
                container('docker') {
                    script {
                        echo "🔨 Building question-service..."

                        sh '''
                            echo "Waiting for Docker daemon..."
                            timeout 60 sh -c 'until docker info >/dev/null 2>&1; do sleep 1; done'
                            echo "Docker daemon ready!"
                        '''

                        sh '''
                            echo $DOCKER_HUB_CREDENTIALS_PSW | docker login -u $DOCKER_HUB_CREDENTIALS_USR --password-stdin
                        '''

                        sh '''
                            if ! docker buildx inspect multi >/dev/null 2>&1; then
                                echo "Creating builder..."
                                docker buildx create --name multi --use
                            else
                                echo "Using existing builder: multi"
                                docker buildx use multi
                            fi
                            docker buildx inspect --bootstrap
                        '''

                        sh """
                            docker buildx build \\
                                --builder multi \\
                                --platform linux/amd64 \\
                                -f question-service/Dockerfile \\
                                --target prod \\
                                -t ${DOCKER_HUB_REPO}:${IMAGE_TAG} \\
                                -t ${DOCKER_HUB_REPO}:latest \\
                                --push \\
                                .
                        """

                        echo "Built and pushed: ${DOCKER_HUB_REPO}:${IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Update Kubernetes') {
            when {
                expression { env.BUILD_QUESTION_SERVICE == 'true' }
            }
            steps {
                container('kubectl') {
                    script {
                        echo "Updating deployment with patch..."

                        sh """
                            kubectl patch deployment question-deployment -n default \\
                                --type='json' \\
                                -p='[{"op": "replace", "path": "/spec/template/spec/containers/0/image", "value":"${DOCKER_HUB_REPO}:${IMAGE_TAG}"}]'

                            echo "Waiting for rollout to complete..."
                            kubectl rollout status deployment/question-deployment \\
                                -n default \\
                                --timeout=5m
                        """

                        echo "Deployment patched and rolled out successfully"
                    }
                }
            }
        }

        stage('Verify Deployment') {
            when {
                expression { env.BUILD_QUESTION_SERVICE == 'true' }
            }
            steps {
                container('kubectl') {
                    script {
                        echo "Verifying deployment..."

                        sh '''
                            echo "=== Pod Status ==="
                            kubectl get pods -l app=question -n default -o wide

                            echo ""
                            echo "=== Deployment Status ==="
                            kubectl get deployment question-deployment -n default

                            echo ""
                            echo "=== Current Image ==="
                            kubectl get deployment question-deployment -n default -o jsonpath='{.spec.template.spec.containers[0].image}'
                            echo ""

                            echo ""
                            echo "=== Waiting for pods to be ready ==="
                            kubectl wait --for=condition=ready pod -l app=question -n default --timeout=5m
                        '''

                        echo "Deployment verified successfully"
                    }
                }
            }
        }
    }

    post {
        always {
            container('docker') {
                sh 'docker logout || true'
            }
        }
        success {
            echo 'Pipeline completed successfully!'
            script {
                if (env.BUILD_QUESTION_SERVICE == 'true') {
                    echo "Question Service deployed: ${DOCKER_HUB_REPO}:${IMAGE_TAG}"
                } else {
                    echo "Question Service: No changes - skipped"
                }
            }
        }
        failure {
            echo 'Pipeline failed!'
        }
        cleanup {
            cleanWs()
        }
    }
}