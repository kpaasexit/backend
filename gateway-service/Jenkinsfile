pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins
  nodeSelector:
    kubernetes.io/hostname: kpaas-contest-9.worker01
  containers:
  - name: kubectl
    image: bitnami/kubectl:1.27
    command:
    - sleep
    args:
    - infinity
    resources:
      requests:
        cpu: 10m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi
  - name: gradle
    image: gradle:8.14.3-jdk17
    command:
    - sleep
    args:
    - infinity
    resources:
      requests:
        cpu: 10m
        memory: 512Mi
      limits:
        cpu: 500m
        memory: 2Gi
  - name: docker
    image: docker:24-dind
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""
    command:
    - sh
    args:
    - -c
    - |
      mkdir -p /etc/docker
      echo '{"insecure-registries":["nexus.cicd.svc.cluster.local:5000"]}' > /etc/docker/daemon.json
      dockerd-entrypoint.sh --host=tcp://0.0.0.0:2375
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 300m
        memory: 1Gi
    securityContext:
      privileged: true
"""
        }
    }

    options {
                disableConcurrentBuilds()
                timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        NEXUS_CREDENTIALS = credentials('nexus-docker-credentials')

        NEXUS_REGISTRY = 'nexus-docker.210-178-1-144.nip.io'
        NEXUS_REPO = ''

        IMAGE_NAME = 'exit-gateway-service'
        IMAGE_TAG = "1.1.${BUILD_NUMBER}"
        FULL_IMAGE_PATH = "${NEXUS_REGISTRY}/${IMAGE_NAME}"

        DOCKER_HOST = "tcp://localhost:2375"
        GIT_DIFF = ''
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (env.GIT_PREVIOUS_SUCCESSFUL_COMMIT) {
                        echo "Comparing with previous: ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT}"
                        GIT_DIFF = sh(
                            script: "git diff --name-only ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT} ${env.GIT_COMMIT}",
                            returnStdout: true
                        ).trim()
                    } else {
                        echo "First build - building all"
                        GIT_DIFF = "ALL"
                    }
                    echo "Changed files:\n${GIT_DIFF}"
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = GIT_DIFF.split('\n')
                    env.BUILD_GATEWAY_SERVICE = 'false'

                    if (GIT_DIFF == 'ALL') {
                        env.BUILD_GATEWAY_SERVICE = 'true'
                        echo "First build - will build gateway-service"
                    } else {
                        for (String file : changedFiles) {
                            if (file.startsWith('gateway-service/') ||
                                file.startsWith('common/') ||
                                file == 'build.gradle' ||
                                file == 'settings.gradle' ||
                                file.startsWith('gradle/') ||
                                file == 'Jenkinsfile' ||
                                file == 'gateway-service/Jenkinsfile') {
                                env.BUILD_GATEWAY_SERVICE = 'true'
                                echo "Changes detected: ${file}"
                                break
                            }
                        }
                    }

                    echo env.BUILD_GATEWAY_SERVICE == 'true' ?
                        "Will build gateway-service" :
                        "Skipping gateway-service"
                }
            }
        }

        stage('Generate REST Docs Snippets') {
            when {
                expression { env.BUILD_GATEWAY_SERVICE == 'true' }
            }
            steps {
                container('gradle') {
                    script {
                        sh '''
                            echo "Running tests to generate REST Docs snippets..."
                            gradle :gateway-service:restDocsTest --no-daemon
                        '''

                        echo "Verifying REST Docs index.html existence..."

                        def docsPath = "gateway-service/src/main/resources/static/back-docs/index.html"

                        def fileExists = sh(
                            script: "test -f ${docsPath} && echo 'EXISTS' || echo 'NOT_FOUND'",
                            returnStdout: true
                        ).trim()

                        if (fileExists == 'EXISTS') {
                            echo "Success: index.html found at ${docsPath}"
                        } else {
                            error "FATAL: index.html not found at ${docsPath}. REST Docs generation failed."
                        }
                    }
                }
            }
        }

        stage('Build Gateway Service') {
            when {
                expression { env.BUILD_GATEWAY_SERVICE == 'true' }
            }
            steps {
                container('docker') {
                    script {
                        echo "🔨 Building gateway-service..."

                        sh '''
                            echo "Waiting for Docker daemon..."
                            timeout 60 sh -c 'until docker info >/dev/null 2>&1; do sleep 1; done'
                            echo "Docker daemon ready!"
                        '''

                        sh """
                            echo \$NEXUS_CREDENTIALS_PSW | docker login -u \$NEXUS_CREDENTIALS_USR --password-stdin ${NEXUS_REGISTRY}
                        """

                        sh '''
                            mkdir -p /etc/buildkit
                            echo '[registry."nexus.cicd.svc.cluster.local:5000"]' > /etc/buildkit/buildkitd.toml
                            echo '  http = true' >> /etc/buildkit/buildkitd.toml
                            echo '  insecure = true' >> /etc/buildkit/buildkitd.toml

                            echo "=== buildkitd.toml content ==="
                            cat /etc/buildkit/buildkitd.toml
                        '''

                        sh '''
                            if docker buildx inspect multi >/dev/null 2>&1; then
                                echo "Removing existing builder..."
                                docker buildx rm multi || true
                            fi

                            echo "Creating new builder with config..."
                            docker buildx create --name multi \
                                --driver docker-container \
                                --driver-opt network=host \
                                --buildkitd-flags '--allow-insecure-entitlement network.host' \
                                --config /etc/buildkit/buildkitd.toml \
                                --use

                            docker buildx inspect --bootstrap
                        '''

                        sh """
                            docker buildx build \\
                                --builder multi \\
                                --platform linux/amd64 \\
                                -f gateway-service/Dockerfile \\
                                --target prod \\
                                -t ${FULL_IMAGE_PATH}:${IMAGE_TAG} \\
                                -t ${FULL_IMAGE_PATH}:latest \\
                                --push \\
                                .
                        """

                        echo "Built and pushed: ${FULL_IMAGE_PATH}:${IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Update Kubernetes') {
            when {
                expression { env.BUILD_GATEWAY_SERVICE == 'true' }
            }
            steps {
                container('kubectl') {
                    script {
                        echo "Updating deployment with patch..."

                        sh """
                            kubectl patch deployment gateway-deployment -n default \\
                                --type='json' \\
                                -p='[{"op": "replace", "path": "/spec/template/spec/containers/0/image", "value":"${FULL_IMAGE_PATH}:${IMAGE_TAG}"}]'

                            echo "Waiting for rollout to complete..."
                            kubectl rollout status deployment/gateway-deployment \\
                                -n default \\
                                --timeout=10m
                        """

                        echo "Deployment patched and rolled out successfully"
                    }
                }
            }
        }

        stage('Verify Deployment') {
            when {
                expression { env.BUILD_GATEWAY_SERVICE == 'true' }
            }
            steps {
                container('kubectl') {
                    script {
                        echo "Verifying deployment..."

                        sh '''
                            echo "=== Pod Status ==="
                            kubectl get pods -l app=gateway-service -n default -o wide

                            echo ""
                            echo "=== Deployment Status ==="
                            kubectl get deployment gateway-deployment -n default

                            echo ""
                            echo "=== Current Image ==="
                            kubectl get deployment gateway-deployment -n default -o jsonpath='{.spec.template.spec.containers[0].image}'
                            echo ""

                            echo ""
                            echo "=== Waiting for pods to be ready ==="
                            kubectl wait --for=condition=ready pod -l app=gateway-service -n default --timeout=10m
                        '''

                        echo "Deployment verified successfully"
                    }
                }
            }
        }
    }

    post {
        always {
            container('docker') {
                sh """
                    docker logout ${NEXUS_REGISTRY} || true
                """
            }
        }
        success {
            echo 'Pipeline completed successfully!'
            script {
                if (env.BUILD_GATEWAY_SERVICE == 'true') {
                    echo "Gateway Service deployed: ${FULL_IMAGE_PATH}:${IMAGE_TAG}"
                } else {
                    echo "Gateway Service: No changes - skipped"
                }
            }
        }
        failure {
            echo 'Pipeline failed!'
        }
        cleanup {
            cleanWs()
        }
    }
}