jwt:
  secret_key: YOUR_BASE64_ENCODED_SECRET_KEY_HERE

spring:
  security:
    oauth2:
      client:
        registration:
          kakao:
            client-id: your-kakao-client-id
            client-secret: your-kakao-secret
          naver:
            client-id: your-naver-client-id
            client-secret: your-naver-secret
