pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('🔍 Immediate JAR Check') {
            steps {
                sh '''
                    echo "========================================"
                    echo "📍 Current Directory"
                    echo "========================================"
                    pwd

                    echo ""
                    echo "========================================"
                    echo "📂 Gradle Wrapper Directory Contents"
                    echo "========================================"
                    ls -lah gradle/wrapper/

                    echo ""
                    echo "========================================"
                    echo "🔎 Search for JAR file"
                    echo "========================================"
                    find . -name "gradle-wrapper.jar" -ls || echo "❌ NOT FOUND ANYWHERE"

                    echo ""
                    echo "========================================"
                    echo "✅ File Existence Test"
                    echo "========================================"
                    if [ -f gradle/wrapper/gradle-wrapper.jar ]; then
                        echo "✅ gradle-wrapper.jar EXISTS"
                        file gradle/wrapper/gradle-wrapper.jar
                        du -h gradle/wrapper/gradle-wrapper.jar
                    else
                        echo "❌ gradle-wrapper.jar MISSING"
                        exit 1
                    fi

                    echo ""
                    echo "========================================"
                    echo "📋 Git Tracked Files Check"
                    echo "========================================"
                    git ls-files | grep gradle-wrapper.jar || echo "❌ NOT TRACKED BY GIT"
                '''
            }
        }

        // 나머지 빌드는 JAR 확인 후에만 진행
        stage('Build Docker') {
            steps {
                sh 'docker build -t myapp .'
            }
        }
    }
}