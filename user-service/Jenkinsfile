pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  serviceAccountName: jenkins
  nodeSelector:
    worker: "true"
  containers:
  - name: kubectl
    image: alpine:latest
    command:
    - sleep
    args:
    - infinity
    resources:
          requests:
            cpu: 50m
            memory: 128Mi
          limits:
            cpu: 200m
            memory: 256Mi
  - name: docker
    image: docker:24-dind
    command:
    - sleep
    args:
    - infinity
    securityContext:
      privileged: true
    volumeMounts:
    - name: docker-sock
      mountPath: /var/run/docker.sock
  volumes:
  - name: docker-sock
    hostPath:
      path: /var/run/docker.sock
      type: Socket
"""
        }
    }

    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials')
        DOCKER_HUB_REPO = 'leesy010504/exit-user-service'
        IMAGE_TAG = "1.1.${BUILD_NUMBER}"
        GIT_DIFF = ''
    }

    stages {
        stage('Install kubectl') {
            steps {
                container('kubectl') {
                    sh '''
                        apk add --no-cache curl
                        curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl /usr/local/bin/
                        kubectl version --client
                    '''
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (env.GIT_PREVIOUS_SUCCESSFUL_COMMIT) {
                        echo "Comparing with previous: ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT}"
                        GIT_DIFF = sh(
                            script: "git diff --name-only ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT} ${env.GIT_COMMIT}",
                            returnStdout: true
                        ).trim()
                    } else {
                        echo "First build - building all"
                        GIT_DIFF = "ALL"
                    }
                    echo "Changed files:\n${GIT_DIFF}"
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = GIT_DIFF.split('\n')
                    env.BUILD_USER_SERVICE = 'false'

                    if (GIT_DIFF == 'ALL') {
                        env.BUILD_USER_SERVICE = 'true'
                        echo "First build - will build user-service"
                    } else {
                        for (String file : changedFiles) {
                            if (file.startsWith('user-service/') ||
                                file.startsWith('common/') ||
                                file == 'build.gradle' ||
                                file == 'settings.gradle' ||
                                file.startsWith('gradle/')) {
                                env.BUILD_USER_SERVICE = 'true'
                                echo "Changes detected: ${file}"
                                break
                            }
                        }
                    }

                    echo env.BUILD_USER_SERVICE == 'true' ?
                        "✅ Will build user-service" :
                        "⏭️ Skipping user-service"
                }
            }
        }

        stage('Build User Service') {
            when {
                expression { env.BUILD_USER_SERVICE == 'true' }
            }
            steps {
                container('docker') {
                    script {
                        echo "🔨 Building user-service..."

                        sh '''
                            echo $DOCKER_HUB_CREDENTIALS_PSW | docker login -u $DOCKER_HUB_CREDENTIALS_USR --password-stdin
                        '''

                        sh '''
                            if ! docker buildx inspect multi >/dev/null 2>&1; then
                                echo "Creating builder..."
                                docker buildx create --name multi --use
                            else
                                echo "Using existing builder: multi"
                                docker buildx use multi
                            fi
                            docker buildx inspect --bootstrap
                        '''

                        sh """
                            docker buildx build \\
                                --builder multi \\
                                --platform linux/amd64 \\
                                -f user-service/Dockerfile \\
                                --target prod \\
                                -t ${DOCKER_HUB_REPO}:${IMAGE_TAG} \\
                                -t ${DOCKER_HUB_REPO}:latest \\
                                --push \\
                                .
                        """

                        echo "✅ Built and pushed: ${DOCKER_HUB_REPO}:${IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Update Kubernetes') {
            when {
                expression { env.BUILD_USER_SERVICE == 'true' }
            }
            steps {
                container('kubectl') {
                    script {
                        echo "🚀 Updating deployment..."

                        sh """
                            kubectl set image deployment/user-deployment \\
                                user-service=${DOCKER_HUB_REPO}:${IMAGE_TAG} \\
                                -n default

                            kubectl rollout status deployment/user-deployment -n default --timeout=5m
                        """

                        echo "✅ Deployment updated"
                    }
                }
            }
        }

        stage('Verify Deployment') {
            when {
                expression { env.BUILD_USER_SERVICE == 'true' }
            }
            steps {
                container('kubectl') {
                    script {
                        echo "🔍 Verifying deployment..."

                        sh '''
                            kubectl get pods -l app=user-service -n default
                            kubectl wait --for=condition=ready pod -l app=user-service -n default --timeout=5m
                        '''

                        echo "✅ Deployment verified"
                    }
                }
            }
        }
    }

    post {
        always {
            container('docker') {
                sh 'docker logout || true'
            }
        }
        success {
            echo '🎉 Pipeline completed successfully!'
            script {
                if (env.BUILD_USER_SERVICE == 'true') {
                    echo "✅ User Service deployed: ${DOCKER_HUB_REPO}:${IMAGE_TAG}"
                } else {
                    echo "ℹ️ User Service: No changes - skipped"
                }
            }
        }
        failure {
            echo '❌ Pipeline failed!'
        }
        cleanup {
            cleanWs()
        }
    }
}