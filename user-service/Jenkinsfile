pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  containers:
  - name: kubectl
    image: bitnami/kubectl:latest
    command: ['cat']
    tty: true
"""
        }
    }

    stages {
        stage('Test') {
            steps {
                container('kubectl') {
                    sh 'kubectl version --client'
                    sh 'kubectl get pods -n default'
                }
            }
        }
    }
}
