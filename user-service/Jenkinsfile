pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  nodeSelector:
    worker: "true"
  containers:
  - name: kubectl
    image: alpine:latest
    command: ['sleep']
    args: ['infinity']
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 200m
        memory: 128Mi
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ['sleep']
    args: ['infinity']
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 1000m
        memory: 512Mi
    volumeMounts:
    - name: docker-config
      mountPath: /kaniko/.docker
  volumes:
  - name: docker-config
    secret:
      secretName: docker-hub-secret
"""
        }
    }

    environment {
        DOCKER_HUB_REPO = 'leesy010504/exit-user-service'
        IMAGE_TAG = "1.1.${BUILD_NUMBER}"
        GIT_DIFF = ''
    }

    stages {
        stage('Install kubectl') {
            steps {
                container('kubectl') {
                    sh '''
                        apk add --no-cache curl
                        curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl /usr/local/bin/
                    '''
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (env.GIT_PREVIOUS_SUCCESSFUL_COMMIT) {
                        GIT_DIFF = sh(
                            script: "git diff --name-only ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT} ${env.GIT_COMMIT}",
                            returnStdout: true
                        ).trim()
                    } else {
                        GIT_DIFF = "ALL"
                    }
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def changedFiles = GIT_DIFF.split('\n')
                    env.BUILD_USER_SERVICE = 'false'

                    if (GIT_DIFF == 'ALL') {
                        env.BUILD_USER_SERVICE = 'true'
                    } else {
                        for (String file : changedFiles) {
                            if (file.startsWith('user-service/') ||
                                file.startsWith('common/') ||
                                file == 'build.gradle' ||
                                file == 'settings.gradle' ||
                                file.startsWith('gradle/')) {
                                env.BUILD_USER_SERVICE = 'true'
                                break
                            }
                        }
                    }
                }
            }
        }

        stage('Build User Service') {
            when {
                expression { env.BUILD_USER_SERVICE == 'true' }
            }
            steps {
                container('kaniko') {
                    sh """
                        /kaniko/executor \\
                            --context=\${WORKSPACE} \\
                            --dockerfile=user-service/Dockerfile \\
                            --destination=${DOCKER_HUB_REPO}:${IMAGE_TAG} \\
                            --destination=${DOCKER_HUB_REPO}:latest \\
                            --cache=true \\
                            --cache-repo=${DOCKER_HUB_REPO}/cache \\
                            --target=prod
                    """
                }
            }
        }

        stage('Update Kubernetes') {
            when {
                expression { env.BUILD_USER_SERVICE == 'true' }
            }
            steps {
                container('kubectl') {
                    sh """
                        kubectl set image deployment/user-deployment \\
                            user-service=${DOCKER_HUB_REPO}:${IMAGE_TAG} \\
                            -n default

                        kubectl rollout status deployment/user-deployment -n default --timeout=5m
                    """
                }
            }
        }

        stage('Verify') {
            when {
                expression { env.BUILD_USER_SERVICE == 'true' }
            }
            steps {
                container('kubectl') {
                    sh '''
                        kubectl get pods -l app=user-service -n default
                        kubectl wait --for=condition=ready pod -l app=user-service -n default --timeout=5m
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '🎉 Success!'
        }
        failure {
            echo '❌ Failed!'
        }
    }
}